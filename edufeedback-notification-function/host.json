{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "visibilityTimeout": "00:00:30",
      "maxDequeueCount": 5,
      "messageEncoding": "base64",
      "newBatchThreshold": 0
    }
  }
}
