{
  "info": {
    "name": "EduFeedback Cloud - Azure JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "httpBase",
      "value": "https://func-edufeedback-http-cpd4hpdubre3d5gf.brazilsouth-01.azurewebsites.net/api"
    },
    {
      "key": "notificationBase",
      "value": "https://func-edufeedback-notification-aphqckeegvfrb7bc.brazilsouth-01.azurewebsites.net/api"
    },
    {
      "key": "reportBase",
      "value": "https://func-edufeedback-report-d8a8e3f0c6hsd8ac.brazilsouth-01.azurewebsites.net/api"
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin123"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "feedbackId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Autenticação",
      "item": [
        {
          "name": "Login administrativo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{httpBase}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar sem token deve falhar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{httpBase}}/api/v1/feedbacks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Feedback HTTP",
      "item": [
        {
          "name": "Criar feedback normal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{httpBase}}/api/v1/feedbacks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"A aula foi clara e objetiva, com bons exemplos práticos.\",\n  \"nota\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('feedbackId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar feedback crítico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{httpBase}}/api/v1/feedbacks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Não consegui acompanhar o conteúdo e preciso de apoio adicional.\",\n  \"nota\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('feedbackId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar feedbacks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{httpBase}}/api/v1/feedbacks",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar feedback",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{httpBase}}/api/v1/feedbacks/{{feedbackId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejeitar JSON malformado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{httpBase}}/api/v1/feedbacks",
            "body": {
              "mode": "raw",
              "raw": "{ \"descricao\": \"incompleto\",",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
